# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# ── JWT ───────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ── Storage ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI ────────────────────────────────────────────────────
# Groq API Key (for chat and SQL agent - fast text inference)
# Get from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Gemini API Key (for image classification and resolution verification)
# Get from: https://cloud.google.com/docs/authentication/application-default-credentials
GEMINI_API_KEY=your_gemini_api_key

# ── SMS (MSG91) ───────────────────────────────────────────
MSG91_API_KEY=your_msg91_api_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# ── Firebase FCM ─────────────────────────────────────────
# Path to service account JSON (never commit the actual file)
FIREBASE_CREDENTIALS_PATH=credentials/firebase-adminsdk.json

# ── Google OAuth ─────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID for your mobile/web app
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── Aadhaar KYC Provider ─────────────────────────────────
# Requires empanelment with UIDAI or a licensed KYC provider (IDfy, AuthBridge, Signzy, etc.)
# Leave blank to use DEV_MODE mock
AADHAR_KYC_PROVIDER=surepass
AADHAR_KYC_API_KEY=your_kyc_provider_api_key
AADHAR_KYC_URL=https://kyc-api.surepass.io/api/v1
AADHAR_KYC_ACCOUNT_ID=                          # IDfy only

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use "*" only in development. In production set your frontend URL(s).
# Example: CORS_ORIGINS=https://civic.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=*

# ── Dev mode ─────────────────────────────────────────────
# When true: OTPs logged to console, photos saved locally, FCM not sent
DEV_MODE=true
