# DEVELOPMENT: Copy this file to .env and fill in your actual values
# cp .env.example .env
#
# This file serves double duty:
#   1. Docker Compose reads it for ${...} interpolation (POSTGRES_*, PORT, UID, ...)
#   2. It is injected into the containers as environment variables (env_file:)
#
# PRODUCTION: Use a real secret store (AWS Secrets Manager / Parameter Store)
# instead of a .env file. Never commit .env to version control.

# ── Docker Compose ────────────────────────────────────────────────
# Host UID/GID baked into the image so bind mounts stay writable (run `id -u`).
UID=1000
GID=1000
# Host port the API is published on
PORT=8000
# Host port for the api-dev (auto-reload) service — kept separate to avoid a clash
DEV_PORT=8001
# Host port for Postgres, bound to 127.0.0.1 only
DB_PORT=5434
UVICORN_WORKERS=2

# ── Database ──────────────────────────────────────────────────────
# These feed BOTH the `db` service and the DATABASE_URL that Compose builds.
POSTGRES_USER=civic
POSTGRES_PASSWORD=civic
POSTGRES_DB=civic
#
# Compose sets DATABASE_URL itself from the POSTGRES_* values above, so you do
# not normally need to set it here. The value below is the equivalent for
# running outside Docker (host -> published DB_PORT).
# Note: no ?sslmode=require — the stock postgres image does not serve SSL.
DATABASE_URL=postgresql://civic:civic@localhost:5434/civic

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Storage ───────────────────────────────────────────────────────
# "local" writes to the uploads/ volume and serves it at /uploads.
STORAGE_BACKEND=local
#
# Absolute origin clients use to reach this API. Photo URLs are built from it
# and stored in the database, so changing it later does not rewrite existing
# rows — set it to the origin your clients actually use, not "localhost", as
# soon as anything other than curl on this machine is talking to the API.
# If you run the api-dev profile on DEV_PORT, point this at that port instead.
# Required, and must be https, in production.
PUBLIC_BASE_URL=http://localhost:8000

# Only used when STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI ────────────────────────────────────────────────────────────
# Optional. Without these, image classification and chat degrade to no-ops.
# Groq (chat + SQL agent): https://console.groq.com
GROQ_API_KEY=
# Gemini (image classification, resolution verification)
GEMINI_API_KEY=

# ── SMS (MSG91) ───────────────────────────────────────────────────
# Required in production — phone OTP is the only universal login path.
MSG91_API_KEY=
MSG91_TEMPLATE_ID=

# ── Firebase FCM ──────────────────────────────────────────────────
# Path to the service account JSON (never commit the actual file).
FIREBASE_CREDENTIALS_PATH=credentials/firebase-adminsdk.json

# ── Email (SMTP) ──────────────────────────────────────────────────
# Required in production — worker invitations are the only onboarding path.
# Gmail: port 587 for STARTTLS, 465 for SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@civicapp.in
SMTP_TLS=true

# ── App URLs (used in worker invitation emails) ───────────────────
APP_DOWNLOAD_URL=https://civicapp.in/download
APP_HELP_URL=https://civicapp.in/help
SUPPORT_EMAIL=support@civicapp.in

# ── Google OAuth ──────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# ── Aadhaar KYC Provider ──────────────────────────────────────────
# Requires empanelment with UIDAI or a licensed provider (Surepass, IDfy, ...).
# Leave blank to use the DEV_MODE mock.
AADHAR_KYC_PROVIDER=surepass
AADHAR_KYC_API_KEY=
AADHAR_KYC_URL=
AADHAR_KYC_ACCOUNT_ID=

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated allowed origins. "*" is for development only.
CORS_ORIGINS=*

# ── Environment ───────────────────────────────────────────────────
# development | production
#
# This is the gate. It sets the default for every switch below, and it decides
# whether a bad configuration is a warning (development) or a refusal to start
# (production). Startup validation runs in both — in development the problems
# are logged as warnings so you can see what production would reject.
ENVIRONMENT=development
APP_VERSION=1.0.0
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_SIZE=10485760

# ── Integration backends ──────────────────────────────────────────
# Each is either the real provider or "console", which logs what would have
# been sent instead of sending it. "console" is rejected in production.
#
# For local development leave these as console until you have real credentials.
SMS_BACKEND=console            # msg91 | console
EMAIL_BACKEND=console          # smtp | console
PUSH_BACKEND=console           # fcm | console
AADHAAR_BACKEND=console        # surepass | idfy | console
# WARNING: GOOGLE_AUTH_BACKEND=console accepts ANY string as a valid Google ID
# token. It is a complete authentication bypass and exists only so that local
# development does not need a real Google project.
GOOGLE_AUTH_BACKEND=console    # google | console

# Turn these on once you have credentials; they gate the production checks.
GOOGLE_AUTH_ENABLED=false
AADHAAR_ENABLED=false

# ── Exposure switches ─────────────────────────────────────────────
# Leave unset to follow ENVIRONMENT (on in development, off in production).
DOCS_ENABLED=true                    # /docs and /redoc
OTP_ECHO_IN_RESPONSE=true            # return the OTP in the send-OTP response
POOL_HEALTH_ENDPOINT_ENABLED=true    # /health/pool

# ── Operations ────────────────────────────────────────────────────
# Run the hourly escalation loop and the pool monitor in this process. These are
# NOT safe to run in more than one process — duplicate runs double-award
# rewards. Keep uvicorn at one worker, or run a separate jobs process.
RUN_BACKGROUND_JOBS=true

# Blank follows ENVIRONMENT: DEBUG/text/file-on in development, INFO/json/
# file-off in production. DEBUG records include OTPs, so it is rejected in prod.
LOG_LEVEL=
LOG_FORMAT=
LOG_TO_FILE=
LOG_DIR=logs

# Required in production to call POST /setup/admin while no admin exists.
SETUP_TOKEN=

# ── Monitoring ────────────────────────────────────────────────────
# Leave blank to disable Sentry.
SENTRY_DSN=

# ── Deprecated ────────────────────────────────────────────────────
# DEV_MODE no longer controls any behaviour directly — nothing outside
# app/core/config.py reads it. It survives only as a compatibility alias: set it
# true in development and it forces every backend above to "console" and turns
# the exposure switches on, so an old .env keeps working. It logs a
# DeprecationWarning, and it is a hard error in production.
#
# Leave it false and use the explicit switches above.
DEV_MODE=false
