# ── Secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Credentials (never commit these) ─────────────────────
credentials/
*-adminsdk-*.json
*serviceAccountKey*.json
*client_secret*.json

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ── Virtual environments ──────────────────────────────────
venv/
.venv/
env/
.env/

# ── Logs ─────────────────────────────────────────────────
logs/
*.log

# ── Alembic ──────────────────────────────────────────────
# Keep migrations tracked, ignore only autogenerated temp files
alembic/__pycache__/

# ── IDE / OS ──────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# ── Local dev uploads (DEV_MODE photos) ──────────────────
uploads/

# ── Misc ─────────────────────────────────────────────────
*.sqlite3
*.db