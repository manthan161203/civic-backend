# Secrets — never bake into image
.env
.env.*
!.env.example

# Credentials
credentials/
*-adminsdk-*.json
*serviceAccountKey*.json
*client_secret*.json

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Dev / OS
.git/
.gitignore
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Logs & uploads (mounted as volumes at runtime)
logs/
uploads/
*.log

# Docs
*.md
git_commands.md

# NOTE: tests/ is deliberately NOT excluded. The `tests` compose service runs
# pytest inside this image against the real Postgres service, so the suite has
# to be present. It is a few KB and imports nothing the runtime does not already
# have. The old `test_api.py` exclusion was here because that file fired 136
# live HTTP requests at import time; it has been deleted.